# ---------------------------------------------------------------------------
# Copy to .env for local development: cp .env.example .env
# Never commit .env. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ---------------------------------------------------------------------------

NODE_ENV=development

# Public origin used for canonical URLs, Open Graph, and CSRF origin checks.
APP_URL=http://localhost:3000

# SQLite file. The directory must exist and be on persistent storage in production.
DATABASE_URL="file:./data/app.db"

# 32-byte base64 key used to encrypt TOTP secrets at rest (AES-256-GCM).
MFA_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

# 32-byte base64 key used to hash IP addresses in audit/session records.
IP_HASH_SECRET=REPLACE_WITH_32_BYTE_BASE64_KEY

# Trust X-Forwarded-For only when a known reverse proxy sits in front.
TRUST_PROXY=false

# Master secret for the single OWNER account. On startup, if no OWNER exists,
# one is created automatically; the owner signs in at /admin/login with this
# value and then sets their own name and email. At least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OWNER_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARS

# Optional SMTP delivery. When unset, emails are written to the server log
# as a redacted preview and the UI clearly reports that delivery is not configured.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="Support <no-reply@example.com>"

# Optional: allow `npm run db:seed` to create demo data. Never enable in production.
ALLOW_SEED=false
