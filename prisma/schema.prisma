// Prisma schema for the ticketing platform.
// SQLite does not support Prisma enums, so status/role/priority/category are
// strings validated centrally in shared/domain.ts and at every trust boundary.

generator client {
  provider = "prisma-client"
  output   = "../prisma/generated"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String
  passwordHash       String
  // Staff (ADMIN/OWNER) authenticate with a high-entropy secret instead of a
  // password. Only the SHA-256 hash is stored; the raw secret is shown once.
  staffSecretHash    String?   @unique
  role               String    @default("USER")
  status             String    @default("ACTIVE")
  emailVerifiedAt    DateTime?
  // Staff start with a placeholder identity and complete name/email themselves.
  profileCompletedAt DateTime?
  lastLoginAt        DateTime?
  passwordChangedAt  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions           Session[]
  mfaCredential      MfaCredential?
  recoveryCodes      RecoveryCode[]
  passwordResets     PasswordResetToken[]
  emailVerifications EmailVerificationToken[]

  requestedTickets Ticket[]        @relation("TicketRequester")
  assignedTickets  Ticket[]        @relation("TicketAssignee")
  messages         TicketMessage[]
  auditLogs        AuditLog[]      @relation("AuditActor")

  @@index([role, status])
  @@index([createdAt])
}

model Session {
  id                String    @id @default(cuid())
  tokenHash         String    @unique
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mfaSatisfied      Boolean   @default(false)
  reauthenticatedAt DateTime?
  userAgent         String?
  ipHash            String?
  createdAt         DateTime  @default(now())
  lastSeenAt        DateTime  @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model MfaCredential {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             String    @default("TOTP")
  secretCiphertext String
  confirmedAt      DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())
}

model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Ticket {
  // SQLite only supports autoincrement on an integer primary key. The public
  // ticket reference is derived from this number; access is still authorized
  // per object, never by knowing the id.
  id            Int       @id @default(autoincrement())
  subject       String
  description   String
  category      String
  status        String    @default("OPEN")
  priority      String    @default("NORMAL")
  requesterId   String
  requester     User      @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  assigneeId    String?
  assignee      User?     @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastMessageAt DateTime  @default(now())
  resolvedAt    DateTime?
  closedAt      DateTime?

  messages TicketMessage[]

  @@index([requesterId, updatedAt])
  @@index([assigneeId, status])
  @@index([status, priority, updatedAt])
  @@index([category])
  @@index([createdAt])
}

model TicketMessage {
  id         String    @id @default(cuid())
  ticketId   Int
  ticket     Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String
  author     User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body       String
  visibility String    @default("PUBLIC")
  createdAt  DateTime  @default(now())
  editedAt   DateTime?

  @@index([ticketId, createdAt])
  @@index([authorId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   String?
  ipHash     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
}
